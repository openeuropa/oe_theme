{#
/**
 * @file
 * File translation pattern.
 */
#}

{# Process value objects into ECL compatible array. #}
{% set _translations = [] %}
{% for item in translations %}
  {% set _translation_meta = '(' ~ item.extension|upper  ~ ')' %}
  {% if item.size %}
    {% set _translation_meta = '(' ~ item.size|format_size ~ ' - ' ~ item.extension|upper  ~ ')' %}
  {% endif %}
  {% set _translations = _translations|merge([{
    'title': item.language_code|to_native_language,
    'meta': _translation_meta,
    'lang': item.language_code|to_internal_language_id,
    'download': {
      'link': {
        'label': button_label|default('Download'|t),
        'path': item.url,
      },
      'icon': {
        'path': ecl_icon_path,
      },
    },
  }]) %}
{% endfor %}
{% if _translations is not empty %}
  {% set _translation = {
    'sr_toggle': translation_toggle_label|default("Other languages"|t) ~ " (" ~ translations|length ~ ")",
    'items': _translations,
  } %}
{% endif %}

{% set _meta = '(' ~ file.extension|upper  ~ ')' %}
{% if file.size %}
  {% set _meta = '(' ~ file.size|format_size ~ ' - ' ~ file.extension|upper  ~ ')' %}
{% endif %}

{% set _primary_meta = [] %}
{% if publication_date is not empty %}
  {% set _primary_meta = _primary_meta|merge([publication_date]) %}
{% endif %}

{% include '@ecl-twig/file' with {
  'title': file.title,
  'language': file.language_code|to_language,
  'meta': _meta,
  'icon': {
    'name': file.extension|to_file_icon,
    'family': 'phosphor',
  },
  'download': {
    'link': {
      'label': button_label|default('Download'|t),
      'path': file.url,
    },
    'icon': {
      'path': ecl_icon_path,
    },
    'extra_attributes': link_attributes|default([]),
  },
  'translation': _translation|default([]),
  'primary_meta': _primary_meta
} only %}
