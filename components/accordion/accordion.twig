{#
/**
 * @file
 * Accordion component.
 */
#}
{% set _items = [] %}
{% for _item in items %}
  {% set _items = _items|merge([{
    toggle: {
      label: _item.title
    },
    content: _item.body
  }]) %}
{% endfor %}
{% set _icon = sidebar ? [
  {
    name: "sliders-horizontal",
    family: "phosphor",
    title: "Expand"
  },
  {
    name: "minus",
    family: "phosphor",
    title: "Collapse"
  }
] : [
  {
    name: 'plus'
  },
  {
    name: 'minus'
  },
] %}

{% include '@ecl-twig/accordion' with {
  'items': _items,
  'icon': _icon,
  'color_mode': color_mode|default(''),
  'extra_classes': extra_classes|default(''),
  'extra_attributes': extra_attributes|default([]),
} %}
