{#
/**
 * @file
 * News ticker pattern.
 */
#}
{% set _items = [] %}
{% for _item in items %}
  {% set _icon = [] %}
  {% if _item.icon is not empty %}
    {% set _icon = {
      name: _item.icon,
    } %}
    {% if _item.icon_family is not empty and _item.icon_family != 'icons' %}
      {% set _icon = _icon|merge({
        family: _item.icon_family,
      }) %}
    {% endif %}
  {% endif %}
  {% set _items = _items|merge([{
    content: _item.content,
    link: _item.link,
    external: _item.external_link|default(false),
    icon: _icon,
  }]) %}
{% endfor %}

{% include '@ecl-twig/news-ticker' with {
  'id': identifier|default(''),
  'items': _items,
  'counter_label': counter_label|default('of'),
  'color_mode': color_mode|default(''),
  'sr_previous': 'Previous news item'|t,
  'sr_next': 'Next news item'|t,
  'sr_pause': 'Pause news ticker'|t,
  'sr_play': 'Play news ticker'|t,
  'extra_attributes': extra_attributes|default([])
} only %}
