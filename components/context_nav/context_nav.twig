{#
/**
 * @file
 * Contextual navigation.
 */
#}
{% set _label = label|render %}
{% set _definitions = [] %}
{% for _item in items %}
  {% set _definitions = _definitions|merge([{
    link: {
      label: _item.label,
      path: _item.href,
      external: _item.is_external|default(false),
    },
  }]) %}
{% endfor %}
{% if _definitions is not empty %}
  {% include '@ecl-twig/description-list' with {
    variant: 'horizontal',
    items: [{
      term: _label,
      definition: _definitions,
      type: 'link-inline',
    }],
    visible_items: limit|default(0),
    more_label: more_label|default('More'|t),
  } only %}
{% endif %}
