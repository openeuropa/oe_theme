{#
/**
 * @file
 * Story card component.
 */
#}
{# Process items to the ECL compatible array. #}
{% set _items = [] %}
{% for item in items %}
  {% set _card_link = {} %}
  {% if item.url is not empty and item.url_text is not empty %}
    {% set _card_link = {
      'link': {
        'path': item.url,
        'label': item.url_text,
        'icon_position': 'after',
      },
      'icon': get_link_icon(item.url),
      'extra_attributes': item.link_extra_attributes|default([]),
    } %}
  {% endif %}

  {% set _picture = {} %}
  {% if item.image is not empty %}
    {% set _picture = {
      'img': {
        'src': item.image,
        'alt': item.image_alt|default(''),
      },
    } %}
    {% if item.sources is not empty and item.sources is iterable %}
      {% set _picture = _picture|merge({'sources': item.sources}) %}
    {% endif %}
  {% endif %}

  {% set _items = _items|merge([{
    'teaser_label': item.teaser_label|default(''),
    'title': item.title|default(''),
    'description': item.description|default(''),
    'author': item.author|default(''),
    'role': item.role|default(''),
    'source': item.source|default(''),
    'picture': _picture,
    'card_link': _card_link,
  }]) %}
{% endfor %}

{% include '@ecl-twig/story-card' with {
  'variant': variant|default('story'),
  'title': title|default(''),
  'description': description|default(''),
  'items': _items,
  'color_mode': color_mode|default(''),
  'sr_prev': 'Previous card'|t,
  'sr_next': 'Next card'|t,
  'sr_play': 'Play story cards'|t,
  'sr_pause': 'Pause story cards'|t,
  'extra_classes': extra_classes|default(''),
  'extra_attributes': extra_attributes|default([]),
} only %}
