{#
/**
 * @file
 * Link block.
 */
#}

{% set _links = {} %}
{% for link in links %}
  {% set _link = {
    link: {
      label : link.label,
      path : link.url,
      type: 'standalone'
    }
  } %}
  {% set _icon = get_link_icon(link.url, 'xs') %}
  {% if link.is_external or _icon.name == 'arrow-square-out' %}
    {% set _link = _link|merge({
      'icon': _icon|merge({'name': 'arrow-square-out', 'family': 'phosphor'})
    }) %}
  {% endif %}
  {% set _links = _links|merge([_link]) %}
{% endfor %}

{% include '@oe_theme/compositions/ec-component-link-block/link-block.html.twig' with {
  title: title,
  links: _links,
} %}
