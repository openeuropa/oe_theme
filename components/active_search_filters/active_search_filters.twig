{#
/**
 * @file
 * Active search filters pattern.
 */
#}
<div class="active-search-filters ecl-u-d-m-flex">
  <div class="active-search-filters__name ecl-u-flex-shrink-0 ecl-u-mb-s ecl-u-mr-s ecl-u-pt-xs">
    <span class="ecl-u-type-s ecl-u-type-uppercase ecl-u-type-color-dark-80">{{ name }}</span>
  </div>
  <div class="active-search-filters__items ecl-u-flex-grow-1">
    {% for item in items %}
      {% if item.url %}
        <a href="{{ item.url }}" class="ecl-tag ecl-tag--removable ecl-u-mr-xs ecl-u-mb-s">
          <span class="ecl-tag__label">{{ item.label }}</span>
          <span class="ecl-tag__icon">
            {% include '@ecl-twig/icon' with {
              icon: {
                name: 'x',
                family: 'phosphor',
                size: 'xs',
              },
              extra_accessibility: {
                title: 'Dismiss'|t,
              },
            } only %}
          </span>
        </a>
      {% else %}
        <div class="ecl-tag ecl-tag--removable ecl-u-mr-xs ecl-u-mb-s">
          <span class="ecl-tag__label">{{ item.label }}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>
