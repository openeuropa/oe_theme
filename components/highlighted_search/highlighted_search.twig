{#
/**
 * @file
 * Highlighted search component.
 */
#}

{# Prepare the search field. The id is passed explicitly so that the hidden
   label generated by ECL is tied to the input. #}
{% set _search_input = {
  id: 'ecl-highlighted-search-input'|clean_unique_id,
  name: input_name|default(''),
  placeholder: placeholder|default(''),
} %}

{# Prepare the suggested searches, rendered as a set of tags. #}
{% set _tags = [] %}
{% for suggestion in suggestions|default([]) %}
  {% if suggestion.label is not empty %}
    {% set _tags = _tags|merge([{
      tag: {
        type: 'link',
        path: suggestion.url|default(''),
        label: suggestion.label,
        external: suggestion.url|default('')|is_external_url,
      },
    }]) %}
  {% endif %}
{% endfor %}

{% include '@ecl-twig/highlighted-search' with {
  color_mode: color_mode|default(''),
  title: title|default(''),
  description: description|default(''),
  search_input: _search_input,
  search_helper: helper_text|default(''),
  search_button: {
    label: button_label|default('Search'|t),
  },
  suggestion_label: suggestion_label|default(''),
  suggestion: _tags is not empty ? { items: _tags } : {},
  extra_classes: extra_classes|default(''),
  extra_attributes: extra_attributes|default([]),
} only %}
