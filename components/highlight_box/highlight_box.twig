{#
/**
 * @file
 * Highlight box component.
 */
#}
{% set icon_size = ecl_component_library == 'eu' ? 'm' : 'xs' %}

{% set _icon = icon is not empty ? to_ecl_icon(icon, icon_size) : [] %}

{% set _link = [] %}
{% if link.href is not empty %}
  {% set _link = {
    link: {
      label: link.label|default(link.href),
      path: link.href,
    },
    icon: get_link_icon(link.href),
  } %}
{% endif %}

{% include '@ecl-twig/highlight-box' with {
  title: title|default(''),
  description: description|default(''),
  icon: _icon,
  link: _link,
  color_mode: color_mode|default(''),
  extra_classes: extra_classes|default(''),
  extra_attributes: extra_attributes|default([]),
} only %}
