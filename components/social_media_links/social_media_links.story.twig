{% for _variant in ['horizontal', 'vertical'] %}
  <h2 class="ecl-u-type-heading-2">
    Variant: {{ _variant|render }}
  </h2>
  {% include 'oe_theme:social_media_links' with {
    variant: _variant,
    title: 'View European Commission on:',
    links: [
      {
        service: 'facebook',
        label: 'Facebook',
        url: '#',
      },
      {
        service: 'twitter',
        label: 'Twitter',
        url: '#',
      },
      {
        service: 'instagram',
        label: 'Instagram',
        url: '#',
        hide_label: true,
      },
      {
        label: 'See more',
        url: '#',
      },
    ],
  } only %}
  <hr class="ecl-separator ecl-u-mt-l">
{% endfor %}
