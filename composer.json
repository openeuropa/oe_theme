{
    "name": "openeuropa/oe_theme",
    "description": "OpenEuropa base theme.",
    "type": "drupal-theme",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "cweagans/composer-patches": "^2.0",
        "drupal/core": "^10.3 || ^11",
        "drupal/smart_trim": "^2",
        "drupal/stable": "^2.0",
        "drupal/twig_field_value": "^2.0",
        "drupal/ui_patterns": "^1.11",
        "openeuropa/ecl-twig-loader": "^4.0",
        "openeuropa/oe_time_caching": "^1.5",
        "openeuropa/oe_webtools": "^1.35"
    },
    "require-dev": {
        "lullabot/mink-selenium2-driver": "1.6.0 as 1.7.3",
        "composer/installers": "^2.3",
        "drupal/address": "~2",
        "drupal/composite_reference": "^2.1",
        "drupal/config_devel": "^1.9",
        "drupal/core-composer-scaffold": "^10.3 || ^11",
        "drupal/core-dev": "^10.3 || ^11",
        "drupal/core-utility": "^10.3 || ^11",
        "drupal/datetime_range_timezone": "^1.0.0-alpha4",
        "drupal/datetime_testing": "^1.0",
        "drupal/description_list_field": "^1.0",
        "drupal/drupal-extension": "^5.0",
        "drupal/emr": "^1.3",
        "drupal/entity_browser": "^2.15",
        "drupal/entity_reference_revisions": "~1.11",
        "drupal/extra_field": "3.0.0-beta1",
        "drupal/field_group": "~3.2",
        "drupal/inline_entity_form": "~3",
        "drupal/json_field": "^1.2",
        "drupal/media_avportal": "~2",
        "drupal/renderviz": "^1.0@alpha",
        "drupal/styleguide": "^2.1.1",
        "drupal/typed_link": "^2.0",
        "drush/drush": "^12.4 || ^13",
        "ec-europa/toolkit": "^10.23",
        "friends-of-behat/service-container-extension": "^1.0",
        "openeuropa/behat-transformation-context": "^0.3",
        "openeuropa/code-review-drupal": "^1.0.0-alpha1",
        "openeuropa/oe_contact_forms": "^1.14",
        "openeuropa/oe_content": "4.x-dev",
        "openeuropa/oe_corporate_blocks": "5.x-dev",
        "openeuropa/oe_corporate_countries": "^2.3",
        "openeuropa/oe_corporate_site_info": "1.x-dev",
        "openeuropa/oe_media": "^1.32",
        "openeuropa/oe_multilingual": "^1.18",
        "openeuropa/oe_paragraphs": "dev-master",
        "openeuropa/oe_search": "2.x-dev",
        "openeuropa/rdf_skos": "^1.0.0"
    },
    "scripts": {
        "post-install-cmd": "./vendor/bin/run drupal:site-setup",
        "post-update-cmd": "./vendor/bin/run drupal:site-setup"
    },
    "autoload": {
        "psr-4": {
            "Drupal\\oe_theme\\": "./src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "build/core/modules/field/tests/src/Traits/EntityReferenceFieldCreationTrait.php"
        ],
        "psr-4": {
            "Drupal\\Tests\\oe_theme\\": "./tests/src/",
            "Drupal\\oe_theme_commands\\": "./toolkit/src/",
            "Drupal\\Tests\\oe_content\\": "./build/modules/contrib/oe_content/tests/src/",
            "Drupal\\Tests\\oe_media\\": "./build/modules/contrib/oe_media/tests/src/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "extra": {
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "installer-paths": {
            "build/core": ["type:drupal-core"],
            "build/profiles/contrib/{$name}": ["type:drupal-profile"],
            "build/modules/contrib/{$name}": ["type:drupal-module"],
            "build/themes/contrib/{$name}": ["type:drupal-theme"]
        },
        "patches": {
            "drupal/core": {
                "https://www.drupal.org/project/drupal/issues/3151609": "https://www.drupal.org/files/issues/2024-06-11/link_internal_as_text_v11-3151609.patch"
            },
            "drupal/drupal-driver": {
                "allow-date-only-date-fields": "https://github.com/jhedstrom/DrupalDriver/commit/eaa9238c8c8e34372dc82ebe5367e6d24b5854e7.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "./build"
            }
        },
        "_readme": [
            "Explicit requirement of lullabot/mink-selenium2-driver v1.6.0 to ensure dragTo() keeps working in tests. Aliased as 1.7.3 because core-dev requires it on that version.",
            "autoload-dev: explicitly mapping EntityReferenceFieldCreationTrait to prevent failures.",
            "Patch for drupal/driver refers to https://github.com/jhedstrom/DrupalDriver/pull/235",
            "Locking extra_field to 3.0.0-beta1 due to issues, will be fixed in EWPP-6001."
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "ec-europa/toolkit-composer-plugin": true,
            "openeuropa/composer-dependent-patches": true,
            "php-http/discovery": false,
            "phpro/grumphp-shim": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": false
        }
    }
}
