{
  "name": "ecl-twig-build",
  "license": "EUPL-1.1",
  "description": "OpenEuropa base theme.",
  "private": true,
  "scripts": {
    "build:copy-twig": "grunt copy",
    "build:copy": "ecl-builder copy",
    "build:styles": "ecl-builder styles",
    "build": "npm-run-all --parallel build:* -ln",
    "watch:scripts": "chokidar \"./sass/**/*.js\" -i \"/node_modules/\" -c \"eslint {path} & npm run build:scripts\"",
    "watch:styles": "chokidar \"./sass/**/*.scss\" -i \"/node_modules/\" -c \"stylelint {path} & npm run build:styles\"",
    "watch": "npm-run-all --parallel watch:* -ln",
    "prepare": "patch-package"
  },
  "dependencies": {
    "@ecl/builder": "5.0.0-alpha.15",
    "@ecl/preset-ec": "5.0.0-alpha.15",
    "@ecl/preset-eu": "5.0.0-alpha.15",
    "@ecl/preset-reset": "5.0.0-alpha.15",
    "@ecl/stylelint-config": "0.2.1",
    "@ecl/theme-ec": "5.0.0-alpha.15",
    "@ecl/theme-eu": "5.0.0-alpha.15",
    "@ecl/twig-templates": "5.0.0-alpha.15",
    "@ecl/utility-background": "5.0.0-alpha.15",
    "@ecl/utility-border": "5.0.0-alpha.15",
    "chokidar-cli": "3.0.0",
    "grunt": "1.6.1",
    "grunt-contrib-copy": "1.0.0",
    "moment": "2.29.4",
    "node-sass": "8.0.0",
    "npm-run-all": "4.1.5",
    "patch-package": "8.0.0",
    "pikaday": "1.8.2",
    "stylelint": "9.1.1",
    "stylelint-config-prettier": "2.1.0",
    "stylelint-no-browser-hacks": "^1.1.0",
    "svg4everybody": "2.1.9"
  },
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9.15.3"
  }
}
