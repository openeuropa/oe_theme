{#
/**
 * @file
 * Theme override to display a Person node in the Openeuropa Compact Teaser view mode.
 */
#}
<article class="ecl-u-d-flex ecl-u-pv-m ecl-u-border-bottom {{ ecl_class_border_color() }}">
  <div role="img" class="ecl-u-flex-shrink-0 ecl-u-mr-s ecl-u-media-a-s ecl-u-media-bg-size-contain ecl-u-media-bg-repeat-none " style="background-image:url({{ content.portrait_image }})"></div>
  <div class="ecl-u-flex-grow-1">
    {% if not node.oe_person_jobs.isEmpty() %}
      <div class="ecl-content-item__meta ecl-u-type-s ecl-u-type-color-neutral-dark-900 ecl-u-mb-xs">{{ content.oe_person_jobs }}</div>
    {% endif %}
    <a href="{{ url }}" class="ecl-link ecl-link--standalone ecl-u-type-bold">{{ overridden_title|default(label) }}</a>
    {% set teaser = overridden_teaser|default(node.oe_teaser.isEmpty() ? '' : content.oe_teaser|field_value|render|striptags|spaceless) %}
    {% if teaser is not empty %}
      <div class="ecl-content-block__description">{{ teaser }}</div>
    {% endif %}
  </div>
</article>
