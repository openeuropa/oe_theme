{#
/**
 * @file
 * Theme override to display the 'list item' type paragraph.
 *
 * @see ./modules/contrib/paragraphs/templates/paragraph.html.twig
 */
#}
{% include 'oe_theme:list_item' with {
  'variant': variant,
  'url': url,
  'title': content.field_oe_title,
  'detail': content.field_oe_text_long,
  'meta': meta,
  'date': date,
  'image': image,
  'color_mode': color_mode|default(''),
  'image_position': image_position|default(''),
  'picture_zoom': picture_zoom|default(false),
  'external_link': external_link|default(false),
  'extra_classes': extra_classes|default(''),
  'extra_attributes': extra_attributes|default([])
} only %}
