{#
/**
 * @file
 * Theme override for the corporate European Commission Standardised footer block.
 *
 * Available variables:
 * - site_owner: Site's owner.
 * - site_specific_footer: renderable array for site specific footer links
 * - corporate_footer: renderable array for corporate footer links
 * @see ./module/contrib/oe_corporate_blocks/templates/oe-corporate-blocks-ec-footer.html.twig
 */
#}
{# Populate the site info section. #}
{% if site_owner and site_owner|length > 1 %}
  {% set site_owner_description = 'This site is co-managed by:<br />'|t ~ site_owner|join('<br />') %}
{% else %}
  {% set site_owner_description = site_owner ? 'This site is managed by:<br />@name'|t({'@name': site_owner|first}) %}
{% endif %}
{# Build the "Subscribe for updates" action button, if a link is provided. #}
{% set _action_button = [] %}
{% if subscribe_link is not empty %}
  {% set _action_button = {
    'link': {
      'label': 'Subscribe for updates'|t,
      'path': subscribe_link,
    },
    'icon': {
      'name': 'envelope-simple',
      'family': 'phosphor',
      'style': 'inverted',
    },
  } %}
{% endif %}
{% set section_site_info = {
  'title': {
    'link': {
      'label': site_specific_footer.site_identity,
      'path': url('<front>'),
    },
    'icon': {
      name: "arrow-left",
      size: "xs",
      style: "inverted",
      transform: "flip-horizontal"
    }
  },
  'description': site_owner ? site_owner_description,
  'action_button': _action_button,
} %}

{% if site_specific_footer.social_links is not empty %}
  {% set section_site_info = section_site_info|merge({
    'social_media': {
      'links': ecl_footer_links(site_specific_footer.social_links),
      'variant': site_specific_footer.social_links['variant'],
    },
  }) %}
{% endif %}

{# Populate the top right row sections containing the site specific links. #}
{% set section_contact = [] %}
{% set section_about = [] %}
{% set section_more = [] %}
{% set section_related = [] %}
{% set sections_custom = [] %}

{% if site_specific_footer.other_links['contact_us'] is defined and site_specific_footer.other_links['contact_us']['links'] is not empty %}
  {% set section_contact = {
    'title': site_specific_footer.other_links['contact_us'].label,
    'links': ecl_footer_links(site_specific_footer.other_links['contact_us']['links']),
  } %}
{% endif %}

{% if site_specific_footer.other_links['about_us'] is defined and site_specific_footer.other_links['about_us']['links'] is not empty %}
  {% set section_about = {
    'title': site_specific_footer.other_links['about_us'].label,
    'links': ecl_footer_links(site_specific_footer.other_links['about_us']['links']),
  } %}
{% endif %}

{% if site_specific_footer.other_links['related_sites'] is defined and site_specific_footer.other_links['related_sites']['links'] is not empty %}
  {% set section_related = {
    'title': site_specific_footer.other_links['related_sites'].label,
    'links': ecl_footer_links(site_specific_footer.other_links['related_sites']['links']),
  } %}
{% endif %}

{# Build the custom sections array. #}
{% if site_specific_footer.other_links['sections_custom'] is defined and site_specific_footer.other_links['sections_custom'] is iterable %}
  {% for section in site_specific_footer.other_links['sections_custom'] %}
    {% set sections_custom = sections_custom|merge([{
      'title': section.label,
      'links': ecl_footer_links(section['links']),
    }]) %}
  {% endfor %}
{% endif %}

{# Populate the common section. #}
{% set _accessibility_link = [] %}
{% if accessibility_link is not empty %}
  {% set _accessibility_link = {
    link: {
      label: 'Accessibility'|t,
      path: accessibility_link,
      external: accessibility_link|is_external_url,
      inverted: ecl_component_library == 'ec',
    },
    extra_attributes: [
      {
        name: 'data-is-accessibility-link',
        value: 'true',
      }
    ],
  } %}
{% endif %}

{% set _links = corporate_footer.legal_navigation ? ecl_footer_links(corporate_footer.legal_navigation) : '' %}
{% if _links is not empty %}
  {% set _links = _links|merge([_accessibility_link]) %}
{% else %}
  {% set _links = _accessibility_link %}
{% endif %}
{% if corporate_footer.social_media_common_links is not empty %}
  {% set _social_media = {
    description: 'Follow the European Commission'|t,
    description_inline: true,
    links: ecl_footer_links(corporate_footer.social_media_common_links)
  } %}
{% endif %}

{% set section_common = {
  'logo': {
    'picture': {
      'img': {
        'alt': 'European Commission logo'|t,
        'src': desktop_logo_path,
      },
    },
    'language': current_language_id,
    'path': path,
  },
  'links_inline': true,
  'links': _links,
  'social_media': _social_media,
  'extra_links': corporate_footer.extra_links ? ecl_footer_links(corporate_footer.extra_links) : [],
} %}

{% block content %}
  {% include '@ecl-twig/site-footer/ecl-site-footer-ec.html.twig' with {
    'section_site_info': section_site_info,
    'section_contact': section_contact,
    'section_about': section_about,
    'section_more': section_more,
    'section_related': section_related,
    'section_common': section_common|default([]),
    'sections_custom': sections_custom|default([]),
  } %}
{% endblock %}
