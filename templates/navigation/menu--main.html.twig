{#
/**
 * @file
 * Theme override to display a menu.
 *
 * @see ./core/themes/stable/templates/navigation/menu.html.twig
 */
#}
{% if links %}
  {% include 'oe_theme:navigation_menu' with {
    label: 'Menu'|t,
    close: close,
    items: links,
    variant: variant|default('default'),
  } only %}
{% endif %}
