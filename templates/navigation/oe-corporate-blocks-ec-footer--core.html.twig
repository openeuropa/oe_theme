{#
/**
 * @file
 * Theme override for the corporate European Commission Core footer block.
 *
 * Available variables:
 * - site_owner: Site's owner.
 * - site_specific_footer: renderable array for site specific footer links
 * - corporate_footer: renderable array for corporate footer links
 * @see ./module/contrib/oe_corporate_blocks/templates/oe-corporate-blocks-ec-footer.html.twig
 */
#}
{# Populate the site info section. #}
{% if(site_owner and site_owner|length > 1 ) %}
  {% set site_owner_description = 'This site is co-managed by:<br />' ~ site_owner|join('<br />') %}
{% else %}
  {% set site_owner_description = site_owner ? 'This site is managed by:<br />@name'|t({'@name': site_owner|first}) %}
{% endif %}
{% set section_site_info = {
  'logo': {
    'picture': {
      'img': {
        'alt': 'European Commission logo'|t,
        'src': desktop_logo_path,
      },
    },
    'language': current_language_id,
    'path': path,
  },
  'description': site_owner ? site_owner_description,
} %}

{# Populate the core section. #}
{% set section_core = {
    'links': ecl_footer_links(corporate_footer.ec_core_section),
} %}

{% set section_common = [] %}
{# Populate the common section. #}
{% if site_specific_footer.social_links is not empty %}
  {# Add social links if we have. #}
  {% set section_common = section_common|merge({
    'social_media': {
      'description': 'Follow us'|t,
      'links': ecl_footer_links(site_specific_footer.social_links),
      'description_inline': true,
      'section_class_name': 'ecl-site-footer__section--social',
    }
  }) %}
{% endif %}
{# Add the accessibility link, if available. #}
{% set _accessibility_link = [] %}
{% if accessibility_link is not empty %}
  {% set _accessibility_link = {
    links: {
      link: {
        label: 'Accessibility'|t,
        path: accessibility_link,
        external: accessibility_link|is_external_url,
        inverted: ecl_component_library == 'ec',
      },
      extra_attributes: [
        {
          name: 'data-is-accessibility-link',
          value: 'true',
        }
      ],
    }
  } %}
{% endif %}
{# Add legal navigation links. #}
{% if corporate_footer.legal_navigation is not empty %}
  {% set _links = ecl_footer_links(corporate_footer.legal_navigation) %}
  {% set _links = _links|merge(_accessibility_link) %}
  {% set section_common = section_common|merge({
    'links': _links,
    'links_inline': true,
    'links_separator': true,
    'section_class_name': 'ecl-site-footer__section--extra-link',
  }) %}
{% endif %}

{% block content %}
  {% include '@ecl-twig/site-footer/ecl-site-footer-ec.html.twig' with {
    'section_site_info': section_site_info,
    'section_core': section_core,
    'section_common': section_common,
  } %}
{% endblock %}
