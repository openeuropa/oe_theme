{#
/**
 * @file
 * List with illustration - number_list variant.
 */
#}
{# Set specific values for the icon_list variant. #}
{% if column > 2 %}
  {% set column = 1 %}
{% endif %}
{% if column > 1 %}
  {# Do not divider for horizontal view. #}
  {% set divider = false %}
{% endif %}

{% set _items = [] %}
{% for item in items %}
  {# No item value or icon for this variant. #}
  {% set item = item|merge({'value': ''}) %}
  {% set item = item|merge({'icon': {}}) %}
  {% set _items = _items|merge([item]) %}
{% endfor %}

{% include '@ecl-twig/list-illustration' with {
  'number_list': true,
  'column': column,
  'items': _items,
  'centered': false,
  'color_mode': color_mode|default(''),
  'extra_classes': extra_classes|default(''),
  'counter_start': counter_start|default(0),
  'divider': divider ?? false,
} only %}
