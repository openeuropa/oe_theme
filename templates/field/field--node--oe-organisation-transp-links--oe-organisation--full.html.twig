{#
/**
 * @file
 * Theme override for the Transparency links field template of the Organisation
 * content type.
 *
 * @see ./core/themes/stable/templates/field/field.html.twig
 */
#}
{% for item in items %}
  <div class="ecl-u-pt-l ecl-u-pb-m ecl-u-border-bottom {{ ecl_class_border_color() }}">
    {% include '@ecl-twig/link' with {
      link: {
        type: 'standalone',
        label: item.content['#title'],
        path: item.content['#url'],
        external: item.content['#url'].toString()|is_external_url,
      }
    } %}
  </div>
{% endfor %}
