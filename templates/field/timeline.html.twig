{# Adding 0 coerces the string value from the formatter setting to an integer,
   as required by the SDC schema. Falsy values (null, "0", 0) become null. #}
{% include 'oe_theme:timeline' with {
  'limit': limit ? limit + 0 : null,
  'limit_to': items | length - 1,
  'button_label': show_more,
  'items': items,
} only %}
